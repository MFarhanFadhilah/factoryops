{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pill FactoryOps Investigation",
  "type": "object",
  "required": [
    "incident_id",
    "machine_id",
    "batch_id",
    "severity",
    "observations",
    "hypotheses",
    "missing_evidence",
    "recommended_action",
    "citations",
    "policy_decision"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object"
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "enum": [
        "CONTINUE_MONITORING",
        "HOLD_AND_INSPECT",
        "HOLD_AND_SAMPLE",
        "PAUSE_AND_INSPECT_TOOLING",
        "CONTROLLED_STOP_AND_MAINTENANCE_REVIEW",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy_decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "HUMAN_APPROVAL_REQUIRED"
      ]
    }
  },
  "additionalProperties": false
}